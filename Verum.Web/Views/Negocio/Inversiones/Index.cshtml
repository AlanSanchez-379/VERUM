@model Verum.Web.Models.ViewModels.NegocioInvestmentsViewModel
@{
    ViewData["Title"] = "Negocio - Inversiones";
}

<div id="inversiones-app" data-register-url="/negocio/inversiones/registrar" class="flex flex-col gap-6 max-w-2xl">
    <div>
        <div class="text-[19px] font-medium text-paper tracking-tight">Inversiones &middot; @Model.Business.Name</div>
        <div class="text-[13px] text-muted mt-1">Capital que metiste en este negocio</div>
    </div>

    <div class="border border-ash rounded-xl bg-graphite p-6">
        <div class="text-[10.5px] font-medium uppercase tracking-[0.14em] text-muted">Total invertido</div>
        <div class="font-mono text-[40px] font-medium text-paper tracking-tight mt-3">@("$" + Model.Total.ToString("N0"))</div>
    </div>

    <div class="border border-ash rounded-xl bg-graphite p-6">
        <div class="text-[13px] font-medium text-paper pb-4">Registrar inversi&oacute;n</div>
        <div id="inversiones-error" class="hidden mb-3 rounded-lg border border-harsh/40 bg-harsh/10 px-3 py-2.5 text-[12px] text-harsh"></div>
        <div class="flex flex-col gap-3.5">
            <div>
                <label class="block text-[11px] font-medium text-muted pb-1.5">Descripci&oacute;n</label>
                <input type="text" id="inversiones-description" placeholder="Ej: Aporte inicial, equipamiento"
                       class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus" />
            </div>
            <div>
                <label class="block text-[11px] font-medium text-muted pb-1.5">Monto</label>
                <input type="number" id="inversiones-amount" min="0" step="0.01"
                       class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus" />
            </div>
            <button type="button" id="inversiones-submit" class="mt-2 rounded-lg bg-paper text-obsidian text-[13px] font-medium py-2.5 hover:bg-paper/90">
                Registrar inversi&oacute;n
            </button>
        </div>
    </div>

    <div class="flex flex-col gap-2">
        @if (Model.Investments.Count == 0)
        {
            <div class="text-[12.5px] text-muted py-3">A&uacute;n no registraste ninguna inversi&oacute;n.</div>
        }
        @foreach (var inv in Model.Investments.OrderByDescending(i => i.Date))
        {
            <div class="flex items-center gap-3.5 rounded-xl border border-ash bg-graphite px-5 py-4">
                <span class="flex-1">
                    <span class="block text-[14.5px] font-medium text-paper">@inv.Description</span>
                    <span class="mt-0.5 block text-[11.5px] text-muted">@inv.Date.ToString("d MMM, HH:mm")</span>
                </span>
                <span class="font-mono text-[15px] font-medium text-paper">@("$" + inv.Amount.ToString("N0"))</span>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/negocio/inversiones.js" defer></script>
}
