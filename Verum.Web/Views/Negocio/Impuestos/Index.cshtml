@model Verum.Web.Models.ViewModels.NegocioTaxesViewModel
@{
    ViewData["Title"] = "Negocio - Impuestos";
}

<div id="impuestos-app" data-register-url="/negocio/impuestos/registrar" class="flex flex-col gap-6 max-w-2xl">
    <div>
        <div class="text-[19px] font-medium text-paper tracking-tight">Impuestos &middot; @Model.Business.Name</div>
        <div class="text-[13px] text-muted mt-1">Obligaciones impositivas de este negocio</div>
    </div>

    <div class="grid grid-cols-2 gap-px bg-graphite-2 border border-ash rounded-xl overflow-hidden">
        <div class="bg-graphite p-6">
            <div class="text-[10.5px] font-medium uppercase tracking-[0.14em] text-muted">Total</div>
            <div class="font-mono text-[30px] font-medium text-paper tracking-tight mt-3">@("$" + Model.Total.ToString("N0"))</div>
        </div>
        <div class="bg-graphite p-6">
            <div class="text-[10.5px] font-medium uppercase tracking-[0.14em] text-muted">Pendiente</div>
            <div class="font-mono text-[30px] font-medium text-paper tracking-tight mt-3">@("$" + Model.Pending.ToString("N0"))</div>
        </div>
    </div>

    <div class="border border-ash rounded-xl bg-graphite p-6">
        <div class="text-[13px] font-medium text-paper pb-4">Registrar impuesto</div>
        <div id="impuestos-error" class="hidden mb-3 rounded-lg border border-harsh/40 bg-harsh/10 px-3 py-2.5 text-[12px] text-harsh"></div>
        <div class="flex flex-col gap-3.5">
            <div>
                <label class="block text-[11px] font-medium text-muted pb-1.5">Nombre</label>
                <input type="text" id="impuestos-name" placeholder="Ej: IVA, Monotributo"
                       class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-[11px] font-medium text-muted pb-1.5">Monto</label>
                    <input type="number" id="impuestos-amount" min="0" step="0.01"
                           class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus" />
                </div>
                <div>
                    <label class="block text-[11px] font-medium text-muted pb-1.5">Vence</label>
                    <input type="date" id="impuestos-duedate"
                           class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus" />
                </div>
            </div>
            <button type="button" id="impuestos-submit" class="mt-2 rounded-lg bg-paper text-obsidian text-[13px] font-medium py-2.5 hover:bg-paper/90">
                Registrar
            </button>
        </div>
    </div>

    <div class="flex flex-col gap-2">
        @if (Model.Taxes.Count == 0)
        {
            <div class="text-[12.5px] text-muted py-3">Todav&iacute;a no ten&eacute;s impuestos registrados.</div>
        }
        @foreach (var t in Model.Taxes.OrderBy(x => x.IsPaid).ThenBy(x => x.DueDate))
        {
            <div class="flex items-center gap-3.5 rounded-xl border border-ash bg-graphite px-5 py-4" data-tax-row data-id="@t.Id">
                <span class="flex h-[38px] w-[38px] items-center justify-center rounded-lg @(t.IsPaid ? "bg-ascend/15" : "bg-ash")">
                    @if (t.IsPaid)
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="#35D07F" stroke-width="1.8" /></svg>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="4" y="5" width="16" height="15" rx="2" stroke="#6F7682" stroke-width="1.5" /><path d="M4 10h16" stroke="#6F7682" stroke-width="1.5" /></svg>
                    }
                </span>
                <span class="flex-1">
                    <span class="block text-[14.5px] font-medium text-paper">@t.Name</span>
                    <span class="mt-0.5 block text-[11.5px] text-muted">@(t.IsPaid ? "Pagado" : "Vence") &middot; @t.DueDate.ToString("d MMM")</span>
                </span>
                <span class="font-mono text-[15px] font-medium @(t.IsPaid ? "text-muted" : "text-paper")">@("$" + t.Amount.ToString("N0"))</span>
                @if (!t.IsPaid)
                {
                    <button type="button" data-mark-paid class="rounded-lg border border-ash px-3 py-2 text-[11.5px] font-medium text-paper hover:bg-graphite-2">
                        Marcar pagado
                    </button>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/negocio/impuestos.js" defer></script>
}
