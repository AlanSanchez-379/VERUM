@model Verum.Web.Models.ViewModels.NegocioSalesViewModel
@{
    ViewData["Title"] = "Negocio - Ventas";
}

<div id="ventas-app" data-register-url="/negocio/ventas/registrar" class="flex flex-col gap-6 max-w-2xl">
    <div>
        <div class="text-[19px] font-medium text-paper tracking-tight">Ventas &middot; @Model.Business.Name</div>
        <div class="text-[13px] text-muted mt-1">Lo que vendiste en este negocio</div>
    </div>

    <div class="border border-ash rounded-xl bg-graphite p-6">
        <div class="text-[10.5px] font-medium uppercase tracking-[0.14em] text-muted">Total vendido</div>
        <div id="ventas-total" class="font-mono text-[40px] font-medium text-paper tracking-tight mt-3">@("$" + Model.Total.ToString("N0"))</div>
    </div>

    <div class="border border-ash rounded-xl bg-graphite p-6">
        <div class="text-[13px] font-medium text-paper pb-4">Registrar venta</div>
        <div id="ventas-error" class="hidden mb-3 rounded-lg border border-harsh/40 bg-harsh/10 px-3 py-2.5 text-[12px] text-harsh"></div>
        <div class="flex flex-col gap-3.5">
            <div>
                <label class="block text-[11px] font-medium text-muted pb-1.5">Descripci&oacute;n</label>
                <input type="text" id="ventas-description" placeholder="Ej: Venta mostrador"
                       class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus" />
            </div>
            <div>
                <label class="block text-[11px] font-medium text-muted pb-1.5">Monto</label>
                <input type="number" id="ventas-amount" min="0" step="0.01"
                       class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus" />
            </div>
            <div>
                <label class="block text-[11px] font-medium text-muted pb-1.5">&iquest;A d&oacute;nde entra?</label>
                <select id="ventas-account" class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus">
                    @foreach (var account in Model.Accounts)
                    {
                        <option value="@account.Id">@account.Name</option>
                    }
                </select>
            </div>
            <button type="button" id="ventas-submit" class="mt-2 rounded-lg bg-paper text-obsidian text-[13px] font-medium py-2.5 hover:bg-paper/90">
                Registrar venta
            </button>
        </div>
    </div>

    <div id="ventas-list" class="flex flex-col gap-2">
        @if (Model.Sales.Count == 0)
        {
            <div class="text-[12.5px] text-muted py-3">A&uacute;n no registraste ninguna venta.</div>
        }
        @foreach (var sale in Model.Sales.OrderByDescending(s => s.Date))
        {
            <div class="flex items-center gap-3.5 rounded-xl border border-ash bg-graphite px-5 py-4">
                <span class="flex-1">
                    <span class="block text-[14.5px] font-medium text-paper">@sale.Description</span>
                    <span class="mt-0.5 block text-[11.5px] text-muted">@sale.Date.ToString("d MMM, HH:mm")</span>
                </span>
                <span class="font-mono text-[15px] font-medium text-ascend">+@("$" + sale.Amount.ToString("N0"))</span>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/negocio/ventas.js" defer></script>
}
