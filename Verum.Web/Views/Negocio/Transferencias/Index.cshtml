@model Verum.Web.Models.ViewModels.NegocioTransferenciasViewModel
@{
    ViewData["Title"] = "Negocio - Transferencias";
}

<div id="negocio-transferencias-app" class="flex flex-col gap-6 max-w-2xl">
    <div>
        <div class="text-[19px] font-medium text-paper tracking-tight">Transferencias &middot; @Model.Business.Name</div>
        <div class="text-[13px] text-muted mt-1">Mov&eacute; plata real entre vos y el negocio. Esto nunca se mezcla solo.</div>
    </div>

    <div class="border border-ash rounded-xl bg-graphite p-6">
        <div class="text-[13px] font-medium text-paper pb-4">Nueva transferencia</div>
        <div id="transfer-error" class="hidden mb-3 rounded-lg border border-harsh/40 bg-harsh/10 px-3 py-2.5 text-[12px] text-harsh"></div>

        <div class="flex rounded-lg border border-ash overflow-hidden mb-4">
            <button type="button" id="dir-to-business" data-direction="to_business" class="flex-1 py-2.5 text-[12.5px] font-medium text-paper bg-graphite-2">
                Personal &rarr; Negocio
            </button>
            <button type="button" id="dir-to-personal" data-direction="to_personal" class="flex-1 py-2.5 text-[12.5px] font-medium text-muted">
                Negocio &rarr; Personal
            </button>
        </div>

        <div class="flex flex-col gap-3.5">
            <div>
                <label class="block text-[11px] font-medium text-muted pb-1.5">Cuenta personal</label>
                <select id="transfer-personal-account" class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus">
                    @foreach (var account in Model.PersonalAccounts)
                    {
                        <option value="@account.Id">@account.Name &middot; $@account.Balance.ToString("N0")</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-[11px] font-medium text-muted pb-1.5">Cuenta del negocio</label>
                <select id="transfer-business-account" class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus">
                    @foreach (var account in Model.BusinessAccounts)
                    {
                        <option value="@account.Id">@account.Name &middot; $@account.Balance.ToString("N0")</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-[11px] font-medium text-muted pb-1.5">Monto</label>
                <input type="number" id="transfer-amount" min="0" step="0.01" placeholder="0"
                       class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus" />
            </div>
            <div>
                <label class="block text-[11px] font-medium text-muted pb-1.5">Nota (opcional)</label>
                <input type="text" id="transfer-note" placeholder="Ej: Aporte de capital, retiro de utilidades"
                       class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus" />
            </div>
            <button type="button" id="transfer-submit" class="mt-2 rounded-lg bg-paper text-obsidian text-[13px] font-medium py-2.5 hover:bg-paper/90">
                Transferir
            </button>
        </div>
    </div>

    <div class="flex flex-col gap-2">
        <div class="text-[10.5px] font-medium uppercase tracking-[0.14em] text-muted px-1">Movimientos recientes</div>
        @if (Model.RecentTransfers.Count == 0)
        {
            <div class="rounded-xl border border-ash bg-graphite px-5 py-4 text-[12.5px] text-muted">A&uacute;n no hiciste ninguna transferencia.</div>
        }
        @foreach (var transfer in Model.RecentTransfers)
        {
            var toBusiness = transfer.Direction == "to_business";
            <div class="flex items-center gap-3.5 rounded-xl border border-ash bg-graphite px-5 py-4">
                <span class="flex h-[38px] w-[38px] items-center justify-center rounded-lg bg-ash text-[11px] font-semibold @(toBusiness ? "text-ascend" : "text-focus")">
                    @(toBusiness ? "→N" : "→P")
                </span>
                <span class="flex-1">
                    <span class="block text-[13px] font-medium text-paper">
                        @(toBusiness ? $"{transfer.PersonalAccountName} → {transfer.BusinessAccountName}" : $"{transfer.BusinessAccountName} → {transfer.PersonalAccountName}")
                    </span>
                    <span class="mt-0.5 block text-[11.5px] text-muted">@(string.IsNullOrWhiteSpace(transfer.Note) ? transfer.Date.ToString("d MMM yyyy") : transfer.Note)</span>
                </span>
                <span class="font-mono text-[14px] font-medium text-paper">$@transfer.Amount.ToString("N0")</span>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/negocio/transferencias.js" defer></script>
}
