@model Verum.Web.Models.ViewModels.NegocioPayablesViewModel
@{
    ViewData["Title"] = "Negocio - Proveedores";
}

<div id="proveedores-app" data-register-url="/negocio/proveedores/registrar" class="flex flex-col gap-6 max-w-2xl">
    <div>
        <div class="text-[19px] font-medium text-paper tracking-tight">Proveedores &middot; @Model.Business.Name</div>
        <div class="text-[13px] text-muted mt-1">Lo que le deb&eacute;s a tus proveedores</div>
    </div>

    <div class="grid grid-cols-2 gap-px bg-graphite-2 border border-ash rounded-xl overflow-hidden">
        <div class="bg-graphite p-6">
            <div class="text-[10.5px] font-medium uppercase tracking-[0.14em] text-muted">Total</div>
            <div class="font-mono text-[30px] font-medium text-paper tracking-tight mt-3">@("$" + Model.Total.ToString("N0"))</div>
        </div>
        <div class="bg-graphite p-6">
            <div class="text-[10.5px] font-medium uppercase tracking-[0.14em] text-muted">Pendiente</div>
            <div class="font-mono text-[30px] font-medium text-paper tracking-tight mt-3">@("$" + Model.Pending.ToString("N0"))</div>
        </div>
    </div>

    <div class="border border-ash rounded-xl bg-graphite p-6">
        <div class="text-[13px] font-medium text-paper pb-4">Registrar cuenta por pagar</div>
        <div id="proveedores-error" class="hidden mb-3 rounded-lg border border-harsh/40 bg-harsh/10 px-3 py-2.5 text-[12px] text-harsh"></div>
        <div class="flex flex-col gap-3.5">
            <div>
                <label class="block text-[11px] font-medium text-muted pb-1.5">Proveedor</label>
                <input type="text" id="proveedores-supplier" placeholder="Ej: Distribuidora del Sur"
                       class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-[11px] font-medium text-muted pb-1.5">Monto</label>
                    <input type="number" id="proveedores-amount" min="0" step="0.01"
                           class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus" />
                </div>
                <div>
                    <label class="block text-[11px] font-medium text-muted pb-1.5">Vence</label>
                    <input type="date" id="proveedores-duedate"
                           class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus" />
                </div>
            </div>
            <button type="button" id="proveedores-submit" class="mt-2 rounded-lg bg-paper text-obsidian text-[13px] font-medium py-2.5 hover:bg-paper/90">
                Registrar
            </button>
        </div>
    </div>

    <div class="flex flex-col gap-2">
        @if (Model.Payables.Count == 0)
        {
            <div class="text-[12.5px] text-muted py-3">Todav&iacute;a no ten&eacute;s cuentas por pagar registradas.</div>
        }
        @foreach (var p in Model.Payables.OrderBy(x => x.IsPaid).ThenBy(x => x.DueDate))
        {
            <div class="flex items-center gap-3.5 rounded-xl border border-ash bg-graphite px-5 py-4" data-payable-row data-id="@p.Id">
                <span class="flex h-[38px] w-[38px] items-center justify-center rounded-lg @(p.IsPaid ? "bg-ascend/15" : "bg-ash")">
                    @if (p.IsPaid)
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="#1FB97A" stroke-width="1.8" /></svg>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="#7C8794" stroke-width="1.5" /></svg>
                    }
                </span>
                <span class="flex-1">
                    <span class="block text-[14.5px] font-medium text-paper">@p.SupplierName</span>
                    <span class="mt-0.5 block text-[11.5px] text-muted">@(p.IsPaid ? "Pagado" : "Vence") &middot; @p.DueDate.ToString("d MMM")</span>
                </span>
                <span class="font-mono text-[15px] font-medium @(p.IsPaid ? "text-muted" : "text-paper")">@("$" + p.Amount.ToString("N0"))</span>
                @if (!p.IsPaid)
                {
                    <button type="button" data-mark-paid class="rounded-lg border border-ash px-3 py-2 text-[11.5px] font-medium text-paper hover:bg-graphite-2">
                        Marcar pagado
                    </button>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/negocio/proveedores.js" defer></script>
}
