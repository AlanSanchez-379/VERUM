@{
    ViewData["Title"] = "Negocio - Cuentas";
}

<div class="flex flex-col gap-6 max-w-2xl">
    <div>
        <div class="text-[19px] font-medium text-paper tracking-tight">Cuentas del negocio</div>
        <div class="text-[13px] text-muted mt-1">Bancos y billeteras propias de este negocio</div>
    </div>

    <div class="border border-dashed border-ash-light rounded-xl p-6" style="background:rgba(46,107,255,.04)">
        <div class="text-[10px] font-medium uppercase tracking-[0.16em] text-focus">En construcción</div>
        <div class="text-[14.5px] leading-relaxed text-paper mt-3">
            Todavía no existen cuentas propias del negocio: Ventas y Gastos no se asocian a una cuenta específica.
        </div>
    </div>
</div>
