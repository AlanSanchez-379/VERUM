@model Verum.Web.Models.ViewModels.SimulacionViewModel
@{
    ViewData["Title"] = "Personal - Simulación";
    var goal = Model.Goal;
    var goalName = goal?.Name ?? "Meta";
    var goalPct = goal?.PercentComplete ?? 0;
    var goalDate = goal?.TargetDate.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.ToString("yyyy-MM-dd");
    var goalDateLabel = goal?.TargetDate.ToString("d MMM yyyy") ?? "-";
}

<div id="sim-app" class="mx-auto flex max-w-md flex-col gap-6"
     data-available="@Model.TotalAvailable" data-saving="@Model.Margin"
     data-goal-name="@goalName" data-goal-pct="@goalPct" data-goal-date="@goalDate" data-goal-date-label="@goalDateLabel">

    <div class="flex items-center justify-between">
        <button type="button" data-back class="text-muted invisible" aria-label="Atr&aacute;s">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M14 6l-7 6 7 6" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
        <div class="text-center">
            <div class="text-[15px] font-medium text-paper">Impacto de la decisi&oacute;n</div>
            <div data-eyebrow class="text-[11.5px] text-focus">Escenario</div>
        </div>
        <a href="/Dashboard" class="text-muted" aria-label="Cerrar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" /></svg>
        </a>
    </div>

    <!-- Paso 1: Decision -->
    <section data-step="build" class="flex flex-col gap-8">
        <div>
            <div class="text-[24px] font-semibold tracking-tight text-paper">&iquest;Qu&eacute; pasa si...?</div>
            <div class="mt-1.5 text-[13px] text-muted">Simula una decisi&oacute;n. Nada se registra.</div>
        </div>

        <div>
            <div class="mb-3.5 text-[10.5px] font-medium uppercase tracking-[0.13em] text-muted">Realidad actual</div>
            <div class="flex items-center justify-between rounded-xl border border-ash bg-graphite px-5 py-4.5">
                <div><div class="text-[11.5px] text-muted">Disponible</div><div class="font-mono text-[24px] font-medium text-paper mt-1">@("$" + Model.TotalAvailable.ToString("N0"))</div></div>
                <div class="text-right"><div class="text-[11.5px] text-muted">Meta @goalName</div><div class="font-mono text-[24px] font-medium text-paper mt-1">@(goalPct)%</div></div>
            </div>
        </div>

        <div>
            <div class="mb-3.5 text-[10.5px] font-medium uppercase tracking-[0.13em] text-muted">La decisi&oacute;n</div>
            <div class="mb-5 flex gap-2" data-kind-toggle>
                <button type="button" data-kind="gastar" data-verb="Gastar hoy" class="flex-1 rounded-lg border border-ash-light bg-ash py-2.5 text-[13px] font-medium text-paper">Gastar</button>
                <button type="button" data-kind="ahorrar" data-verb="Ahorrar hoy" class="flex-1 rounded-lg border border-ash bg-graphite py-2.5 text-[13px] text-muted">Ahorrar</button>
                <button type="button" data-kind="invertir" data-verb="Invertir hoy" class="flex-1 rounded-lg border border-ash bg-graphite py-2.5 text-[13px] text-muted">Invertir</button>
            </div>
            <div class="rounded-xl border border-ash bg-graphite-2 px-5 py-5.5">
                <div class="flex items-baseline justify-between">
                    <span data-verb-label class="text-[12.5px] text-muted">Gastar hoy</span>
                    <span data-sim-amount class="font-mono text-[30px] font-medium tracking-tight text-paper">$0</span>
                </div>
                <input type="range" min="0" max="5000" step="100" value="0" data-sim-slider class="mt-5 w-full accent-focus" />
                <div class="mt-1 flex justify-between text-[10.5px] font-mono text-muted"><span>$0</span><span>$5,000</span></div>
            </div>
        </div>

        <div class="rounded-xl border border-dashed border-ash-light px-5 py-5" style="background:rgba(46,107,255,.04)">
            <div class="text-[10px] font-medium uppercase tracking-[0.16em] text-focus">Escenario &middot; no es tu realidad</div>
            <div class="mt-3 text-[14.5px] leading-relaxed text-paper">Quedar&iacute;as con <span data-sim-after class="font-mono font-medium">@("$" + Model.TotalAvailable.ToString("N0"))</span> disponibles.</div>
        </div>

        <button type="button" data-see-impact class="h-[52px] rounded-xl bg-paper text-[14px] font-semibold text-obsidian">Ver impacto</button>
    </section>

    <!-- Paso 2: Impacto -->
    <section data-step="impact" class="hidden flex-col gap-7">
        <div class="overflow-hidden rounded-xl border border-dashed border-ash-light" style="background:rgba(46,107,255,.03)">
            <div class="grid grid-cols-3 gap-px bg-ash">
                <div class="p-4.5" style="background:#0D1014"><div class="text-[10.5px] uppercase tracking-[0.1em] text-muted">Antes</div><div class="font-mono text-[18px] font-medium text-muted mt-2">@("$" + Model.TotalAvailable.ToString("N0"))</div></div>
                <div class="p-4.5" style="background:#0D1014"><div class="text-[10.5px] uppercase tracking-[0.1em] text-muted">Despu&eacute;s</div><div data-impact-after class="font-mono text-[18px] font-medium text-paper mt-2">$0</div></div>
                <div class="p-4.5" style="background:#0D1014"><div class="text-[10.5px] uppercase tracking-[0.1em] text-muted">Diferencia</div><div data-impact-diff class="font-mono text-[18px] font-medium mt-2 text-harsh">$0</div></div>
            </div>
        </div>

        <div>
            <div class="mb-3.5 text-[10.5px] font-medium uppercase tracking-[0.13em] text-muted">Impacto en tu meta</div>
            <div class="rounded-xl border border-ash bg-graphite p-5">
                <div class="flex items-baseline justify-between">
                    <span class="text-[16px] font-semibold text-paper">@goalName</span>
                    <span data-impact-delay class="font-mono text-[13px] text-muted">+0 d&iacute;as</span>
                </div>
                <div class="relative mt-4.5 h-[3px] bg-ash">
                    <div class="h-full bg-paper" style="width:@(goalPct)%"></div>
                    <div data-impact-bar class="absolute top-0 h-full" style="left:@(goalPct)%;width:0%;background:repeating-linear-gradient(90deg,#4D8DFF 0 3px,transparent 3px 6px)"></div>
                </div>
                <div class="mt-3 flex justify-between text-[11.5px]">
                    <span class="text-muted">Fecha estimada</span>
                    <span class="font-mono text-paper">@goalDateLabel &rarr; <span data-impact-date>@goalDateLabel</span></span>
                </div>
                <div class="mt-4.5 border-t border-ash pt-4 text-[12.5px] leading-relaxed text-muted">
                    Si tomas esta decisi&oacute;n, tu meta podr&iacute;a retrasarse <span data-impact-delay-plain>0 d&iacute;as</span>, seg&uacute;n tu margen actual de @("$" + Model.Margin.ToString("N0")) por periodo.
                </div>
            </div>
        </div>

        <div class="flex flex-col gap-3">
            <a href="/Dashboard" class="flex h-[52px] items-center justify-center rounded-xl bg-paper text-[14px] font-semibold text-obsidian">Tomar esta decisi&oacute;n</a>
            <button type="button" data-discard class="h-[52px] rounded-xl border border-ash text-[14px] font-medium text-muted">Descartar escenario</button>
        </div>
    </section>

</div>

@section Scripts {
    <script src="~/js/personal/simulacion.js" defer></script>
}
