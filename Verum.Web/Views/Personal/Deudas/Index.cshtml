@using Verum.Application.DTOs.Personal
@model List<DebtDto>
@{
    ViewData["Title"] = "Personal - Deudas";
    var totalRemaining = Model.Sum(d => d.RemainingAmount);
    var totalMonthly = Model.Sum(d => d.MonthlyPayment);
}

<div class="flex flex-col gap-6 max-w-2xl">
    <div class="flex items-baseline justify-between">
        <div>
            <div class="text-[19px] font-medium text-paper tracking-tight">Deudas</div>
            <div class="text-[13px] text-muted mt-1">Lo que le debes a alguien m&aacute;s</div>
        </div>
        <a href="/personal/credito" class="text-[12px] font-medium text-focus">Ver cr&eacute;dito &rarr;</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="border border-dashed border-ash rounded-xl p-6 text-[13px] text-muted">No tienes deudas registradas. Buena se&ntilde;al.</div>
    }
    else
    {
        <div class="grid grid-cols-2 gap-px bg-graphite-2 border border-ash rounded-xl overflow-hidden">
            <div class="bg-graphite p-6">
                <div class="text-[10.5px] font-medium uppercase tracking-[0.14em] text-muted">Saldo pendiente</div>
                <div class="font-mono text-[30px] font-medium text-paper tracking-tight mt-3">@("$" + totalRemaining.ToString("N0"))</div>
            </div>
            <div class="bg-graphite p-6">
                <div class="text-[10.5px] font-medium uppercase tracking-[0.14em] text-muted">Pago mensual total</div>
                <div class="font-mono text-[30px] font-medium text-paper tracking-tight mt-3">@("$" + totalMonthly.ToString("N0"))</div>
            </div>
        </div>

        <div class="flex flex-col gap-4">
            @foreach (var debt in Model)
            {
                <div class="border border-ash rounded-xl bg-graphite p-6">
                    <div class="flex items-baseline justify-between">
                        <span class="text-[16px] font-semibold text-paper">@debt.Name</span>
                        <span class="font-mono text-[13px] text-muted">@(debt.PercentPaid)% pagado</span>
                    </div>
                    <div class="font-mono text-[15px] text-paper mt-2.5">@("$" + debt.RemainingAmount.ToString("N0")) <span class="text-muted">restante de @("$" + debt.TotalAmount.ToString("N0"))</span></div>
                    <div class="h-1 rounded-full bg-ash mt-4 overflow-hidden"><div class="h-full bg-paper" style="width:@(debt.PercentPaid)%"></div></div>
                    <div class="flex items-center justify-between mt-3.5">
                        <span class="text-[12px] text-muted">Cuota @("$" + debt.MonthlyPayment.ToString("N0")) / mes</span>
                        <span class="text-[12px] text-muted">Próximo pago @debt.NextDueDate.ToString("d MMM")</span>
                    </div>
                </div>
            }
        </div>
    }
</div>
