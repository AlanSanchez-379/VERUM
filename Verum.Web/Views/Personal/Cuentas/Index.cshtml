@using Verum.Application.DTOs.Personal
@model List<AccountDto>
@{
    ViewData["Title"] = "Personal - Cuentas";
    var total = Model.Sum(a => a.Balance);
}

<div class="flex flex-col gap-6 max-w-2xl">
    <div>
        <div class="text-[19px] font-medium text-paper tracking-tight">Tus cuentas</div>
        <div class="text-[13px] text-muted mt-1">Dinero real disponible &middot; sin contar cr&eacute;dito</div>
    </div>

    <div class="border border-ash rounded-xl bg-graphite p-6">
        <div class="text-[10.5px] font-medium uppercase tracking-[0.14em] text-muted">Total en cuentas</div>
        <div class="font-mono text-[40px] font-medium text-paper tracking-tight mt-3">@("$" + total.ToString("N0"))</div>
    </div>

    <div class="flex flex-col gap-2">
        @foreach (var account in Model)
        {
            <div class="flex items-center gap-3.5 rounded-xl border border-ash bg-graphite px-5 py-4">
                <span class="flex h-[38px] w-[38px] items-center justify-center rounded-lg bg-ash text-[11px] font-semibold text-paper">
                    @(account.Name.Length >= 2 ? account.Name.Substring(0, 2).ToUpper() : account.Name.ToUpper())
                </span>
                <span class="flex-1">
                    <span class="block text-[14.5px] font-medium text-paper">@account.Name</span>
                    <span class="mt-0.5 block text-[11.5px] text-muted">@account.Subtitle</span>
                </span>
                <span class="font-mono text-[15px] font-medium text-paper">@("$" + account.Balance.ToString("N0"))</span>
            </div>
        }
    </div>
</div>
