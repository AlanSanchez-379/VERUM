@model Verum.Web.Models.ViewModels.DineroViewModel
@{
    ViewData["Title"] = "Personal - Realidad";
}

<div class="flex flex-col gap-6 max-w-2xl">
    <div>
        <div class="text-[19px] font-medium text-paper tracking-tight">Tu realidad</div>
        <div class="text-[13px] text-muted mt-1">Todo lo que entr&oacute; y sali&oacute;, en un solo lugar</div>
    </div>

    <div class="grid grid-cols-2 gap-px bg-graphite-2 border border-ash rounded-xl overflow-hidden">
        <div class="bg-graphite p-6">
            <div class="text-[10.5px] font-medium uppercase tracking-[0.14em] text-muted">Dinero disponible</div>
            <div class="font-mono text-[34px] font-medium text-paper tracking-tight mt-3">@("$" + Model.TotalAvailable.ToString("N0"))</div>
        </div>
        <div class="p-6" style="background:#0D1014">
            <div class="text-[10.5px] text-ascend">Margen</div>
            <div class="font-mono text-[34px] font-medium text-ascend mt-3">@("$" + Model.Margin.ToString("N0"))</div>
        </div>
    </div>

    <div class="flex flex-col">
        @for (var i = 0; i < Model.Entries.Count; i++)
        {
            var entry = Model.Entries[i];
            var borderClass = i < Model.Entries.Count - 1 ? "border-b border-graphite-2" : "";
            var amountClass = entry.Amount >= 0 ? "text-ascend" : "text-paper";
            var sign = entry.Amount >= 0 ? "+" : "-";
            <div class="flex items-center gap-3.5 py-4 @borderClass">
                <span class="flex h-[34px] w-[34px] items-center justify-center rounded-lg bg-ash text-[10px] font-semibold text-muted">@entry.Kind.Substring(0, 1)</span>
                <span class="flex-1">
                    <span class="block text-[13.5px] font-medium text-paper">@entry.Label</span>
                    <span class="mt-0.5 block text-[11.5px] text-muted">@entry.Kind @(entry.IsPending ? "· pendiente" : "") &middot; @entry.Date.ToString("d MMM")</span>
                </span>
                <span class="font-mono text-[14px] font-medium @amountClass">@sign@("$" + Math.Abs(entry.Amount).ToString("N0"))</span>
            </div>
        }
    </div>
</div>
