@model Verum.Web.Models.ViewModels.RecurringIncomesViewModel
@{
    ViewData["Title"] = "Personal - Ingresos recurrentes";
}

<div class="flex flex-col gap-6 max-w-2xl">
    <div>
        <div class="text-[19px] font-medium text-paper tracking-tight">Ingresos recurrentes</div>
        <div class="text-[13px] text-muted mt-1">Patrones que esperás cada mes &middot; nunca se cuentan solos como dinero disponible</div>
    </div>

    <div class="border border-ash rounded-xl bg-graphite p-6">
        <div class="text-[13px] font-medium text-paper pb-4">Nuevo patrón</div>
        <div id="patron-error" class="hidden mb-3 rounded-lg border border-harsh/40 bg-harsh/10 px-3 py-2.5 text-[12px] text-harsh"></div>
        <div class="flex flex-col gap-3.5">
            <div>
                <label class="block text-[11px] font-medium text-muted pb-1.5">Nombre</label>
                <input type="text" id="patron-source" placeholder="Ej: Sueldo, Renta, Pensión"
                       class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-[11px] font-medium text-muted pb-1.5">Monto esperado</label>
                    <input type="number" id="patron-amount" min="0" step="0.01"
                           class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus" />
                </div>
                <div>
                    <label class="block text-[11px] font-medium text-muted pb-1.5">Día del mes</label>
                    <input type="number" id="patron-day" min="1" max="28" placeholder="1-28"
                           class="w-full rounded-lg border border-ash bg-graphite-2 px-3.5 py-2.5 text-[13px] text-paper outline-none focus:border-focus" />
                </div>
            </div>
            <button type="button" id="patron-submit" class="mt-2 rounded-lg bg-paper text-obsidian text-[13px] font-medium py-2.5 hover:bg-paper/90">
                Crear patrón
            </button>
        </div>
    </div>

    <div class="flex flex-col gap-2">
        @if (Model.Patterns.Count == 0)
        {
            <div class="text-[12.5px] text-muted py-3">Todav&iacute;a no ten&eacute;s patrones de ingreso recurrente.</div>
        }
        @foreach (var p in Model.Patterns)
        {
            var isPending = Model.Pending.Any(x => x.RecurringIncomeId == p.Id);
            <div class="flex items-center gap-3.5 rounded-xl border border-ash bg-graphite px-5 py-4">
                <span class="flex-1">
                    <span class="block text-[14.5px] font-medium text-paper">@p.Source</span>
                    <span class="mt-0.5 block text-[11.5px] text-muted">D&iacute;a @p.DayOfMonth de cada mes</span>
                </span>
                <span class="font-mono text-[15px] font-medium text-muted">~@("$" + p.ExpectedAmount.ToString("N0"))</span>
                @if (isPending)
                {
                    <span class="text-[10px] font-medium uppercase tracking-[0.08em] text-focus border border-focus/40 rounded px-1.5 py-0.5">Por confirmar</span>
                }
            </div>
        }
    </div>

    @if (Model.Pending.Count > 0)
    {
        <div class="text-[12.5px] text-muted">
            Ten&eacute;s @Model.Pending.Count patr&oacute;n(es) esperando confirmaci&oacute;n este mes &middot;
            <a href="/Dashboard" class="text-focus font-medium">confirmalos desde el inicio &rarr;</a>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/personal/ingresos-recurrentes.js" defer></script>
}
