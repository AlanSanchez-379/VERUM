@{
    ViewData["Title"] = "Registrar";
}

<div class="mx-auto flex max-w-md flex-col gap-6 py-6">
    <div class="text-center">
        <div class="text-[21px] font-medium text-paper tracking-tight">&iquest;Qu&eacute; quer&eacute;s registrar?</div>
        <div class="text-[13px] text-muted mt-1.5">Anot&aacute; algo en tu realidad, r&aacute;pido</div>
    </div>

    <a href="/personal/ingresos" class="flex items-center gap-4 rounded-xl border border-ash bg-graphite px-5 py-5 hover:border-ash-light">
        <span class="flex h-[46px] w-[46px] shrink-0 items-center justify-center rounded-full bg-ascend/15">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 19V5M6 11l6-6 6 6" stroke="#35D07F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
        <span class="flex-1">
            <span class="block text-[15px] font-medium text-paper">Registrar ingreso</span>
            <span class="mt-0.5 block text-[12.5px] text-muted">Te entr&oacute; dinero</span>
        </span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="text-muted"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" /></svg>
    </a>

    <a href="/personal/gastos" class="flex items-center gap-4 rounded-xl border border-ash bg-graphite px-5 py-5 hover:border-ash-light">
        <span class="flex h-[46px] w-[46px] shrink-0 items-center justify-center rounded-full bg-harsh/15">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M6 13l6 6 6-6" stroke="#FF5C67" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
        <span class="flex-1">
            <span class="block text-[15px] font-medium text-paper">Registrar gasto</span>
            <span class="mt-0.5 block text-[12.5px] text-muted">Gastaste dinero</span>
        </span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="text-muted"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" /></svg>
    </a>

    <a href="/Dashboard" class="text-center text-[12.5px] text-muted mt-2">Ir al inicio &rarr;</a>
</div>
