@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_AuthLayout";
}

<div class="rounded-xl border border-ash bg-graphite p-6 text-center">
    <div class="font-mono text-[13px] text-muted">500</div>
    <h1 class="text-[17px] font-semibold text-paper pt-2 pb-1">Algo salió mal</h1>
    <p class="text-[13px] text-muted pb-2">Ocurrió un error inesperado. Probá de nuevo en un momento.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-[11px] text-muted pb-4 font-mono">Request ID: @Model.RequestId</p>
    }
    <a href="/Dashboard" class="inline-block rounded-lg bg-paper text-obsidian text-[13px] font-medium py-2.5 px-5 hover:bg-paper/90">
        Volver al inicio
    </a>
</div>
