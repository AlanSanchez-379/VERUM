<!DOCTYPE html>
<html lang="es" class="bg-obsidian">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Verum</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @await Html.PartialAsync("_PwaHead")
</head>
<body class="bg-obsidian text-paper font-sans antialiased">
    <div class="flex min-h-screen">
        @await Html.PartialAsync("_Sidebar")
        <div class="flex-1 flex flex-col min-w-0">
            @await Html.PartialAsync("_Header")
            <main class="flex-1 px-5 pb-28 pt-6 md:px-10 md:pb-10 md:pt-8">
                @RenderBody()
            </main>
        </div>
    </div>
    @await Html.PartialAsync("_BottomNav")
    @await Html.PartialAsync("_Modal")
    @await Html.PartialAsync("_Toast")

    <script src="~/js/app.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
