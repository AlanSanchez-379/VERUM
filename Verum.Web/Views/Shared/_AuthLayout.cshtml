<!DOCTYPE html>
<html lang="es" class="bg-obsidian">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Verum</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @await Html.PartialAsync("_PwaHead")
</head>
<body class="bg-obsidian text-paper font-sans antialiased">
    <div class="min-h-screen flex items-center justify-center px-5">
        <div class="w-full max-w-sm">
            <div class="flex items-center justify-center gap-2 pb-8">
                <svg width="20" height="20" viewBox="0 0 28 28" fill="none">
                    <path d="M4.6 8.2 L12.4 25.8" stroke="#F5F7FA" stroke-width="3.4" stroke-linecap="square" />
                    <path d="M18.4 13.4 L14.6 24.6" stroke="#F5F7FA" stroke-width="3.4" stroke-linecap="square" />
                    <path d="M12.6 22.4 L22.2 6.8" stroke="#F5F7FA" stroke-width="2.4" stroke-linecap="square" />
                    <path d="M26 1.4 L17.2 3.9 L23.4 11 Z" fill="#F5F7FA" />
                </svg>
                <span class="font-semibold text-[13px] tracking-[0.3em] text-paper">VERUM</span>
            </div>
            @RenderBody()
        </div>
    </div>
</body>
</html>
