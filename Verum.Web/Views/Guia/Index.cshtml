@{
    ViewData["Title"] = "Guía";

    var cuenta = new (string Q, string[] Steps, string? Note)[]
    {
        ("¿Cómo me registro?", new[]
        {
            "Andá a /auth/register (o tocá \"¿Ya tenés cuenta?\" desde la pantalla de inicio de sesión y después \"Crear cuenta\").",
            "Ingresá tu correo y una contraseña de al menos 6 caracteres.",
            "Tocá \"Crear cuenta\".",
        }, "Revisá tu correo para confirmar la cuenta antes de poder iniciar sesión."),

        ("¿Cómo inicio sesión?", new[]
        {
            "Andá a /auth/login.",
            "Ingresá tu correo y contraseña.",
            "Tocá \"Iniciar sesión\".",
        }, null),

        ("¿Cómo cierro sesión?", new[]
        {
            "Abrí \"Configuración\" desde el final del menú lateral.",
            "Tocá \"Cerrar sesión\".",
        }, null),

        ("¿Cómo instalo VERUM en mi celular o PC?", new[]
        {
            "Abrí la app en Chrome, Edge o el navegador de tu celular.",
            "Buscá la opción \"Instalar app\" / \"Agregar a pantalla de inicio\" en el menú del navegador.",
            "Confirmá la instalación — queda como una app normal, sin pestaña de navegador.",
        }, "Funciona igual que en el navegador: no guarda tus datos offline, solo evita tener que abrir el navegador cada vez."),
    };

    var personal = new (string Q, string[] Steps, string? Note)[]
    {
        ("¿Cómo registro un ingreso?", new[]
        {
            "Tocá el botón \"+\" (o \"Registrar\" en el Dashboard) y elegí \"Registrar ingreso\", o andá directo a Personal → Ingresos.",
            "Escribí el monto con el teclado numérico.",
            "Elegí el origen: Sueldo, Venta, Freelance, Regalo, Reembolso, Préstamo u Otro.",
            "Elegí a qué cuenta entra la plata.",
            "Confirmá.",
        }, "El monto se suma de inmediato al saldo real de esa cuenta."),

        ("¿Cómo registro un gasto?", new[]
        {
            "Tocá el botón \"+\" y elegí \"Registrar gasto\", o andá directo a Personal → Gastos.",
            "Escribí el monto con el teclado numérico.",
            "Elegí la categoría del gasto.",
            "Elegí de qué cuenta sale la plata.",
            "Confirmá.",
        }, "Si la cuenta no tiene saldo suficiente, la app no te deja registrar el gasto."),

        ("¿Cómo registro un ingreso recurrente (sueldo, etc.)?", new[]
        {
            "Andá a Personal → Ingresos recurrentes.",
            "Completá el nombre (ej: \"Sueldo\"), el monto esperado y el día del mes en que suele llegar.",
            "Guardá el patrón.",
        }, "Registrar el patrón NO suma dinero todavía — solo crea el recordatorio."),

        ("¿Cómo confirmo un ingreso recurrente cuando llega?", new[]
        {
            "Cuando llega la fecha, aparece una tarjeta en el Dashboard pidiendo confirmar el monto.",
            "Corregí el monto si llegó distinto a lo esperado (o dejalo igual).",
            "Elegí a qué cuenta entró.",
            "Tocá \"Confirmar\" — o \"No llegó nada\" si ese mes no entró esa plata.",
        }, "El dinero disponible no se mueve hasta que confirmás, y nunca se cuenta dos veces el mismo mes."),

        ("¿Cómo marco un compromiso como pagado?", new[]
        {
            "Andá a Personal → Compromisos.",
            "En el compromiso pendiente, elegí de qué cuenta sale el pago.",
            "Tocá \"Marcar pagado\".",
        }, null),

        ("¿Cómo cambio la prioridad de una meta?", new[]
        {
            "Andá a Personal → Prioridades.",
            "Tocá Baja, Media o Alta en la meta que quieras ajustar.",
        }, "La meta con más prioridad es la que se muestra en el Dashboard."),

        ("¿Cómo le agrego una foto a una meta?", new[]
        {
            "Andá a Personal → Metas.",
            "Tocá la meta para expandirla.",
            "Tocá \"Agregar foto\" (o \"Cambiar foto\") y elegí una imagen.",
        }, "La foto se comprime en tu navegador antes de subirse, para que no pese en la base de datos."),

        ("¿Qué significa el porcentaje de una meta?", new[]
        {
            "El \"actual\" de cada meta es siempre el total de dinero real que tenés disponible hoy — el mismo número en todas tus metas.",
            "El porcentaje es cuánto de esa meta podrías cubrir ahora mismo con todo lo que tenés, no un ahorro separado por meta.",
        }, null),

        ("¿Cómo veo mis cuentas, deudas y crédito?", new[]
        {
            "Andá a Personal → Cuentas.",
            "Arriba ves \"esto es lo que tenés en realidad\" (tus cuentas propias).",
            "Abajo, separado, ves tus tarjetas de crédito y deudas — eso no es tu dinero.",
        }, null),
    };

    var negocio = new (string Q, string[] Steps, string? Note)[]
    {
        ("¿Cómo creo un negocio?", new[]
        {
            "Andá a Negocio → Mis negocios.",
            "Completá el nombre y el rubro.",
            "Confirmá — se crea automáticamente una cuenta \"Caja\" para ese negocio.",
        }, null),

        ("¿Cómo cambio entre negocios o renombro uno?", new[]
        {
            "Andá a Negocio → Mis negocios.",
            "Tocá el negocio que querés activar para cambiarte a él.",
            "Para renombrar, tocá el ícono de editar en la fila del negocio, escribí el nuevo nombre y confirmá.",
        }, null),

        ("¿Cómo creo una cuenta del negocio (Caja, banco)?", new[]
        {
            "Andá a Negocio → Cuentas.",
            "Completá el nombre (ej: \"Banco\") y un detalle opcional.",
            "Tocá \"Crear cuenta\".",
        }, null),

        ("¿Cómo registro una venta?", new[]
        {
            "Andá a Negocio → Ventas.",
            "Completá la descripción y el monto.",
            "Dejá desmarcado \"Es venta a crédito\" y elegí a qué cuenta entra.",
            "Tocá \"Registrar venta\".",
        }, "Entra como plata real de inmediato."),

        ("¿Cómo registro una venta a crédito?", new[]
        {
            "Andá a Negocio → Ventas.",
            "Completá la descripción y el monto.",
            "Marcá \"Es venta a crédito\".",
            "Completá el cliente y la fecha en que se cobra.",
            "Tocá \"Registrar venta\".",
        }, "No suma a tu dinero real todavía — queda esperando en Por Cobrar."),

        ("¿Cómo cobro una venta a crédito?", new[]
        {
            "Andá a Negocio → Por cobrar.",
            "En la cuenta pendiente, elegí a qué cuenta entra el cobro.",
            "Tocá \"Marcar cobrado\".",
        }, "Recién ahí se convierte en plata real y suma a Ventas."),

        ("¿Cómo registro un gasto del negocio?", new[]
        {
            "Andá a Negocio → Gastos.",
            "Completá la categoría y el monto.",
            "Elegí de qué cuenta sale.",
            "Tocá \"Registrar\".",
        }, "Si la cuenta no alcanza, la app no deja registrar el gasto."),

        ("¿Cómo registro y pago un costo fijo?", new[]
        {
            "Andá a Negocio → Costos.",
            "Completá el nombre, monto y vencimiento, y registralo.",
            "Cuando lo pagues, tocá \"Marcar pagado\" en ese costo.",
        }, null),

        ("¿Cómo registro y pago un impuesto?", new[]
        {
            "Andá a Negocio → Impuestos.",
            "Completá el nombre, monto y vencimiento, y registralo.",
            "Cuando lo pagues, tocá \"Marcar pagado\".",
        }, null),

        ("¿Cómo registro y pago una cuenta a un proveedor?", new[]
        {
            "Andá a Negocio → Proveedores.",
            "Completá el proveedor, monto y vencimiento, y registralo.",
            "Cuando lo pagues, tocá \"Marcar pagado\".",
        }, null),

        ("¿Cómo transfiero plata entre mi bolsillo y el negocio?", new[]
        {
            "Andá a Negocio → Transferencias.",
            "Elegí la dirección: Personal → Negocio, o Negocio → Personal.",
            "Elegí la cuenta personal y la cuenta del negocio.",
            "Completá el monto y una nota opcional.",
            "Tocá \"Transferir\".",
        }, "No te deja transferir más de lo que hay disponible en la cuenta de origen."),

        ("¿Cómo registro o aporto a una meta del negocio?", new[]
        {
            "Andá a Negocio → Metas.",
            "Para crear una, completá nombre, monto objetivo y fecha.",
            "Para aportarle, abrí la meta y cargá el monto del aporte.",
        }, null),

        ("¿Cómo cambio la prioridad de las metas del negocio?", new[]
        {
            "Andá a Negocio → Prioridades.",
            "Tocá Baja, Media o Alta en la meta que quieras ajustar.",
        }, null),

        ("¿Cómo registro una inversión?", new[]
        {
            "Andá a Negocio → Inversiones.",
            "Completá la descripción y el monto.",
            "Registrala.",
        }, null),
    };
}

<div class="flex flex-col gap-6 max-w-2xl">
    <div>
        <div class="text-[19px] font-medium text-paper tracking-tight">Guía</div>
        <div class="text-[13px] text-muted mt-1">Cómo hacer cada cosa en VERUM, paso a paso</div>
    </div>

    @{
        void RenderSection(string title, (string Q, string[] Steps, string? Note)[] items)
        {
            <div class="flex flex-col gap-2">
                <div class="text-[10.5px] font-medium uppercase tracking-[0.14em] text-muted px-1 pt-2">@title</div>
                @foreach (var item in items)
                {
                    <div class="guia-card border border-ash rounded-xl bg-graphite overflow-hidden">
                        <button type="button" class="w-full text-left px-5 py-4 flex items-center justify-between gap-3" data-guia-toggle>
                            <span class="text-[13.5px] font-medium text-paper">@item.Q</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="shrink-0 text-muted" data-guia-chevron><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" /></svg>
                        </button>
                        <div class="hidden px-5 pb-4" data-guia-detail>
                            <ol class="flex flex-col gap-2 text-[12.5px] text-paper">
                                @for (var i = 0; i < item.Steps.Length; i++)
                                {
                                    <li class="flex gap-2.5">
                                        <span class="font-mono text-[11px] text-muted shrink-0 pt-0.5">@(i + 1).</span>
                                        <span>@item.Steps[i]</span>
                                    </li>
                                }
                            </ol>
                            @if (!string.IsNullOrEmpty(item.Note))
                            {
                                <div class="mt-3 text-[11.5px] text-muted">@item.Note</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        RenderSection("Cuenta", cuenta);
        RenderSection("Personal", personal);
        RenderSection("Negocio", negocio);
    }
</div>

@section Scripts {
    <script src="~/js/guia.js" defer></script>
}
